{
  "name": "@spreddpay/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "dotenv -e ../../.env -- prisma generate",
    "migrate": "dotenv -e ../../.env -- prisma migrate deploy",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "push": "dotenv -e ../../.env -- prisma db push",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "build": "dotenv -e ../../.env -- prisma generate",
    "lint": "eslint src",
    "typecheck": "pnpm run generate && tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@spreddpay/config": "workspace:*",
    "@spreddpay/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.9",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  }
}
